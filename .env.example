# Copiaza acest fisier ca .env.local (local) sau seteaza variabilele in Netlify.
OPENAI_API_KEY=
# Local, daca OPENAI_API_KEY lipseste, se citeste OPENAI_KEY din ../script.env

# Parola de acces (OBLIGATORIE in productie; local, daca lipseste, nu exista login)
APP_PASSWORD=
# Cheia pentru semnarea cookie-ului de sesiune (optional; implicit derivata din APP_PASSWORD)
AUTH_SECRET=

VECTOR_STORE_ID=vs_6af4275e8db48191aa5098c97dbcd2e0
OPENAI_MODEL=gpt-6-luna
REASONING_EFFORT=high
FILE_SEARCH_MAX_RESULTS=30

# Cat timp (secunde) ramane deschisa o conexiune de stream inainte de reconectare.
# Pe Netlify, daca functiile sunt oprite devreme, scade la 8.
MAX_STREAM_SECONDS=20

# Optional (proxy / server de test)
# OPENAI_BASE_URL=
